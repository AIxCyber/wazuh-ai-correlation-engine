{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "title": "SOC - Wazuh AI Correlation Engine",
    "uid": "wazuh-soc",
    "version": 1,
    "tags": ["wazuh", "soc", "security"],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "panels": [
      {
        "id": 1,
        "title": "Alerts Processed",
        "type": "stat",
        "targets": [{
          "expr": "rate(alerts_processed_total[5m])",
          "legendFormat": "Alerts/s"
        }]
      },
      {
        "id": 2,
        "title": "Active Incidents by Severity",
        "type": "bargauge",
        "targets": [{
          "expr": "active_incidents",
          "legendFormat": "{{ severity }}"
        }]
      },
      {
        "id": 3,
        "title": "API Request Duration (p99)",
        "type": "graph",
        "targets": [{
          "expr": "histogram_quantile(0.99, rate(api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }]
      },
      {
        "id": 4,
        "title": "AI Processing Duration",
        "type": "graph",
        "targets": [{
          "expr": "rate(ai_processing_duration_seconds_sum[5m]) / rate(ai_processing_duration_seconds_count[5m])",
          "legendFormat": "avg {{ provider }}"
        }]
      },
      {
        "id": 5,
        "title": "DLQ Size",
        "type": "stat",
        "targets": [{
          "expr": "dlq_size",
          "legendFormat": "Records"
        }]
      },
      {
        "id": 6,
        "title": "Cache Hit Ratio",
        "type": "stat",
        "targets": [{
          "expr": "cache_hit_ratio",
          "legendFormat": "Ratio"
        }]
      }
    ]
  }
}

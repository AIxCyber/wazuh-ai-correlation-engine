# General
APP_NAME=wazuh-ai-correlation-engine
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///data/wazuh_correlator.db
# DATABASE_URL=postgresql://user:password@localhost:5432/wazuh_correlator

# Ingestion
ALERT_SOURCE=local
ALERT_FILE_PATH=data/alerts/
BATCH_SIZE=100
POLL_INTERVAL_SECONDS=30

# Wazuh API Source
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_SSL=true

# Wazuh Indexer Source (OpenSearch-compatible)
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_INDEX=wazuh-alerts-*
WAZUH_INDEXER_VERIFY_SSL=true

# Elasticsearch Source
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=wazuh-alerts-*
ELASTICSEARCH_VERIFY_SSL=true

# Kafka Source
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=wazuh-alerts
KAFKA_GROUP_ID=wazuh-correlation-engine
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Correlation
CORRELATION_WINDOW_MINUTES=5

# Enrichment - Threat Intelligence
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# AI Analysis
AI_MODE=rule
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# API
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200
RATE_LIMIT_ADMIN=200
RATE_LIMIT_SENIOR_ANALYST=150
RATE_LIMIT_ANALYST=100
RATE_LIMIT_ANONYMOUS=30

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501

# Data Retention
ALERT_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
CLEANUP_INTERVAL_HOURS=24
